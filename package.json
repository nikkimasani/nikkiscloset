{
  "name": "nikkis-closet",
  "version": "0.1.0",
  "description": "A digital closet: upload your real clothes, try them on a mannequin, plan and log your OOTD, and match Pinterest inspo to what you own.",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/unit.mjs && node tests/smoke.mjs",
    "deploy:cloudflare": "npx wrangler deploy",
    "deploy:vercel": "npx vercel --prod",
    "test:unit": "node --test tests/unit.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "axe-core": "4.10.2",
    "playwright": "^1.63.0"
  }
}
